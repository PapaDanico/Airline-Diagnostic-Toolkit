{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/certify",
      "destination": "/tools/certification-navigator.html",
      "permanent": true
    },
    {
      "source": "/venture",
      "destination": "/tools/venture-builder.html",
      "permanent": true
    },
    {
      "source": "/structure",
      "destination": "/tools/corporate-structure.html",
      "permanent": true
    },
    {
      "source": "/org",
      "destination": "/tools/organogram-planner.html",
      "permanent": true
    },
    {
      "source": "/scorecard",
      "destination": "/diagnostic.html",
      "permanent": true
    },
    {
      "source": "/fuel",
      "destination": "/tools/fuel-optimizer.html",
      "permanent": true
    },
    {
      "source": "/cask",
      "destination": "/tools/cask-calculator.html",
      "permanent": true
    },
    {
      "source": "/canvas",
      "destination": "/tools/operating-model-canvas.html",
      "permanent": true
    },
    {
      "source": "/data",
      "destination": "/tools/data-request.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    }
  ]
}
